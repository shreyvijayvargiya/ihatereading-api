# GuideForge server — never expose secrets to the Vite/browser app
PORT=8790
GUIDEFORGE_PORT=8790

# ============================================================
# OpenRouter — PUT YOUR KEY HERE (this file: guideforge/server/.env)
# Copy this example to .env and paste a valid key from
# https://openrouter.ai/keys
# Parent repo .env is NOT read by GuideForge for chat.
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FREE_MODEL=openrouter/free

# Existing ihatereading-api scraper base (same machine)
SCRAPER_BASE_URL=http://127.0.0.1:3002
GOOGLE_SEARCH_ENDPOINT=/google-search
SCRAPE_URL_ENDPOINT=/scrape
SCRAPE_MULTIPLE_ENDPOINT=/scrape-multiple

# Optional auth header for scraper
SCRAPER_API_KEY=
