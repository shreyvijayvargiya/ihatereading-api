# OpenRouter (required for content idea synthesis; optional for scrape agents)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional override for this pipeline only
OPENROUTER_CONTENT_RESEARCH_MODEL=
# Reddit agents / AI scraper: default scrape-only. Set 1 to score with OpenRouter.
# REDDIT_USE_LLM=
# All other scrape CLIs: default scrape-only. Set 1 to enable OpenRouter scoring.
# USE_AI=

# Individual influencers agent (optional)
# INFLUENCERS_INTERVAL_MS=30000
# INFLUENCERS_MIN_FOLLOWERS=10000
# INFLUENCERS_TARGET=500
# YOUTUBE_API_KEY=

