# OpenRouter (required for content idea synthesis; optional for scrape agents)
OPENROUTER_API_KEY=
# Default scrape-agent chat model when --use-ai / --llm is on (free Gemini).
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Optional override for this pipeline only
OPENROUTER_CONTENT_RESEARCH_MODEL=
# Reddit agents / AI scraper: default scrape-only. Set 1 to score with OpenRouter.
# REDDIT_USE_LLM=
# All other scrape CLIs: default scrape-only. Set 1 to enable OpenRouter scoring.
# USE_AI=

# Individual influencers agent (optional)
# INFLUENCERS_INTERVAL_MS=30000
# INFLUENCERS_MIN_FOLLOWERS=10000
# INFLUENCERS_TARGET=500
# YOUTUBE_API_KEY=

# Karyam B2B founder leads + AutoSend outreach
# KARYAM_FOUNDERS_INTERVAL_MS=30000
# KARYAM_FOUNDERS_QUERIES_PER_RUN=3
# KARYAM_FOUNDERS_ENRICH_PER_RUN=6
# AUTOSEND_API_KEY=
# AUTOSEND_FROM_EMAIL=hello@karyam.xyz
# AUTOSEND_FROM_NAME=Karyam
# AUTOSEND_PROJECT_ID=

# Programming magazine creators (YouTube + X)
# MAGAZINE_INTERVAL_MS=30000
# MAGAZINE_QUERIES_PER_RUN=3
# MAGAZINE_VIDEOS_PER_CHANNEL=10
# MAGAZINE_MIN_FOLLOWERS=1000

# Claude toprated chat agent
# CLAUDE_TOPRATED_MODEL=anthropic/claude-sonnet-4
# CLAUDE_TOPRATED_MAX_ROUNDS=12

# Reddit scraping problems agent
# REDDIT_SCRAPING_INTERVAL_MS=30000
# REDDIT_SCRAPING_SUBS_PER_RUN=10
# REDDIT_SCRAPING_QUERIES_PER_RUN=3

# Local MLX image generation (Apple Silicon). pip install mlx-openai-server && npm run mlx:images
# MLX_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# MLX_OPENAI_API_KEY=not-needed
# MLX_IMAGE_MODEL=local-image-generation-model
# MLX_IMAGE_MODEL_PATH=black-forest-labs/FLUX.1-schnell
# MLX_IMAGE_CONFIG=flux-schnell
# MLX_IMAGE_QUANTIZE=8
# MLX_IMAGE_SIZE=1024x1024

# Reddit AI scraper (any topic via prompt)
# REDDIT_AI_SCRAPER_PROMPT=find people looking for scrapers and data collection
# REDDIT_AI_SCRAPER_INTERVAL_MS=30000
# REDDIT_AI_SCRAPER_SUBS_PER_RUN=10
# REDDIT_AI_SCRAPER_MAX_SUBS=20

# a16z portfolio companies (4 per tick, site enrich in-process)
# A16Z_INTERVAL_MS=8000
# A16Z_BATCH_SIZE=4

# Business CRM directory (Google + scrape, no AI, 10s loop)
# CRM_INTERVAL_MS=10000
# CRM_QUERIES_PER_RUN=1
# CRM_SCRAPE_LISTS_PER_RUN=2
# CRM_ENRICH_PER_RUN=4
# CRM_RESOLVE_PER_RUN=5
